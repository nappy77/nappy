{
  "name": "loja-eletronicos",
  "version": "1.0.0",
  "description": "Electronics store with React frontend and Express backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "cd frontend && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd frontend && npm run build"
  },
  "keywords": [
    "react",
    "express",
    "ecommerce",
    "electronics"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@react-three/drei": "^10.6.1",
    "@react-three/fiber": "^9.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "firebase-admin": "^13.4.0",
    "gsap": "^3.13.0",
    "mongoose": "^8.17.1",
    "nodemailer": "^7.0.5",
    "stripe": "^18.4.0",
    "three": "^0.179.1"
  },
  "devDependencies": {
    "concurrently": "^8.2.0",
    "nodemon": "^3.0.1"
  }
}
